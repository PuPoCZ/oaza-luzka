rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Plánovač lůžek Oáza klidu: veřejné čtení i zápis, ale jen data plánovače ve správném tvaru.
    function num(v) { return v is int || v is float; }
    function str(v, n) { return v is string && v.size() <= n; }

    match /scenarios/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'note', 'order', 'rooms'])
        && str(request.resource.data.name, 200)
        && str(request.resource.data.note, 5000)
        && num(request.resource.data.order)
        && request.resource.data.rooms is map;
    }

    match /beds/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['sid', 'fk', 'x', 'y', 'rot', 'w', 'l', 'sex', 'hl', 'label'])
        && str(request.resource.data.sid, 40)
        && request.resource.data.fk in ['1NP', '2NP', '3NP']
        && num(request.resource.data.x) && num(request.resource.data.y)
        && request.resource.data.rot in [0, 90, 180, 270]
        && num(request.resource.data.w) && num(request.resource.data.l)
        && request.resource.data.sex in ['', 'Z', 'M']
        && request.resource.data.hl is bool
        && str(request.resource.data.label, 20);
    }

    match /items/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['sid', 'fk', 'kind', 'x', 'y', 'rot', 'w', 'l', 'label'])
        && str(request.resource.data.sid, 40)
        && request.resource.data.fk in ['1NP', '2NP', '3NP']
        && request.resource.data.kind in ['skrin', 'prekazka']
        && num(request.resource.data.x) && num(request.resource.data.y)
        && request.resource.data.rot in [0, 90, 180, 270]
        && num(request.resource.data.w) && num(request.resource.data.l)
        && str(request.resource.data.label, 40);
    }

    match /config/{id} {
      allow read: if true;
      allow create, update: if id == 'settings'
        && request.resource.data.keys().hasOnly(['limits', 'maxPerRoom', 'minArea']);
    }
  }
}
